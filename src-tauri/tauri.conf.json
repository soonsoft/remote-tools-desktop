{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "remote-tools",
  "version": "0.1.0",
  "identifier": "com.remotetools.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "remote-tools",
        "width": 960,
        "height": 640,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "windowEffects": { "effects": ["acrylic"] }
      }
    ]
  },
  "bundle": { "active": true, "targets": ["msi", "app"] }
}
